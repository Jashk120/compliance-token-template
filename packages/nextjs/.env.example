# Frontend (public)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Server: network + operator (the operator holds COMPLIANCE_OFFICER_ROLE)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# Server: issuer DID used to verify investor credentials (Ed25519)
ISSUER_DID=
ISSUER_DID_PRIVATE_KEY=
# Reduced mode only: unset by default. When set, credential verification uses this
# Ed25519 issuer public key (multibase z... or base58) instead of resolving ISSUER_DID.
ISSUER_PUBLIC_KEY=

# Server: HCS audit topic (create with `yarn workspace @sh/nextjs audit:create-topic`)
AUDIT_TOPIC_ID=

# Server: contract addresses (fallback when not present in contracts/deployedContracts.ts)
COMPLIANCE_TOKEN_ADDRESS=
TOKEN_SALE_ADDRESS=

# Server: demo-grade Bearer token required by /api/admin/* routes
ADMIN_API_TOKEN=
