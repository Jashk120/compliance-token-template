# Frontend + API server. Prefer `yarn setup` and `yarn deploy:testnet`, which fill and
# validate these without echoing values. Never commit this file — it is git-ignored.

# Frontend (public — never put a secret here)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Server: network + operator (the operator holds COMPLIANCE_OFFICER_ROLE)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
# Ed25519 raw hex or DER. `yarn doctor` compares its public key to the Mirror Node.
HEDERA_OPERATOR_PRIVATE_KEY=

# Server: issuer used to verify investor credentials (Ed25519).
# Prefer live mode: `yarn deploy:testnet` registers ISSUER_DID and resolves it from HCS.
ISSUER_DID=
ISSUER_DID_PRIVATE_KEY=
# Reduced-mode fallback only: unset by default. When no ISSUER_DID is set, credential
# verification uses this Ed25519 public key (base58 or multibase z...) instead.
ISSUER_PUBLIC_KEY=

# Server: HCS audit topic (`yarn deploy:testnet` creates it if empty)
AUDIT_TOPIC_ID=

# Server: mirror node the audit timeline and account lookups read from. Optional;
# defaults to the public mirror for HEDERA_NETWORK. Override to use a local/private mirror.
HEDERA_MIRROR_URL=

# Server: contract addresses. `yarn deploy:testnet` writes these here; a plain
# `yarn hardhat:deploy` also regenerates contracts/deployedContracts.ts.
COMPLIANCE_TOKEN_ADDRESS=
TOKEN_SALE_ADDRESS=

# Server: demo-grade Bearer token (>= 32 chars) required by /api/admin/* routes
ADMIN_API_TOKEN=
