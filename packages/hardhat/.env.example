# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Prefer `yarn setup` (hidden prompts, mode 0600, validated) over editing this file.
# Deployer key: use EITHER the encrypted keystore (recommended) or a plain testnet key.
# Encrypted keystore: run `yarn hardhat:account:generate` (or `yarn setup`).
DEPLOYER_PRIVATE_KEY_ENCRYPTED=
# Plain testnet key (0x + 64 hex). Testnet only — readable by anything with file access.
DEPLOYER_PRIVATE_KEY=

# Chainlink HBAR/USD feed is selected per network in deploy/02_deploy_price_feed.ts.
# testnet: 0x59bC155EB6c6C415fE43255aF66EcF0523c92B4a
# mainnet: 0xAF685FB45C12b92b5054ccb9313e135525F9b5d5

# Deploy-time role grants (deploy/04_grant_roles.ts). Defaults to the deployer account.
OFFICER_ADDRESS=
# Ed25519 operator 0.0.8812811 acts through the SDK; contracts see its long-zero address.
OPERATOR_ADDRESS=0x000000000000000000000000000000000086790b
# Set true ONLY after the CallerProbe proof confirms the operator's msg.sender address.
GRANT_OPERATOR_OFFICER=false

# Live proof runner (scripts/liveProof.ts). `yarn setup` can generate these. Never commit real keys.
INVESTOR_PRIVATE_KEY=
# Optional: used by `yarn workspace @sh/nextjs credential:issue` as the credential subject when no --address is passed.
INVESTOR_ADDRESS=
OFFICER_PRIVATE_KEY=
