# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn generate or yarn account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Chainlink HBAR/USD feed is selected per network in deploy/02_deploy_price_feed.ts.
# testnet: 0x59bC155EB6c6C415fE43255aF66EcF0523c92B4a
# mainnet: 0xAF685FB45C12b92b5054ccb9313e135525F9b5d5

# Deploy-time role grants (deploy/04_grant_roles.ts). Defaults to the deployer account.
OFFICER_ADDRESS=
# Ed25519 operator 0.0.8812811 acts through the SDK; contracts see its long-zero address.
OPERATOR_ADDRESS=0x000000000000000000000000000000000086790b
# Set true ONLY after LIVE-3 proves the operator's msg.sender address.
GRANT_OPERATOR_OFFICER=false

# Live proof runner (scripts/liveProof.ts). Never commit real keys.
INVESTOR_PRIVATE_KEY=
OFFICER_PRIVATE_KEY=
